{
  "name": "builderwars-live-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "referee": "node scripts/build-referee.mjs",
    "predev": "npm run referee",
    "prebuild": "npm run referee",
    "pretest": "npm run referee",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:native": "npm run referee && tsc --noEmit && vite build --mode native",
    "native:sync": "npm run build:native && cap sync && node scripts/prepare-native.mjs",
    "test": "tsx --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/ios": "8.5.1",
    "chess.js": "1.4.0",
    "peerjs": "1.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@types/node": "22.19.11",
    "esbuild": "0.28.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
